# Every value here is optional — the page works with no configuration at all.
# They are baked in at build time; for runtime switching use URL parameters
# instead (see README, "URL parameters").

# Absolute origin of your Sub2API instance. Usually unnecessary: inside the
# iframe the origin is detected from document.referrer.
VITE_SUB2API_BASE_URL=https://api.example.com

# Fallback brand name, overridden by the instance's site_name setting.
VITE_SITE_NAME=Sub2API

# External documentation URL. 0.2.17 has no /docs route, so leave this empty
# unless you host docs somewhere; it then falls back to the repository.
VITE_DOCS_URL=

VITE_REPO_URL=https://github.com/Wei-Shaw/sub2api
VITE_CONTACT_URL=
