# Every value here is optional — the page works with no configuration at all.
# They are baked in at build time; for runtime switching use URL parameters
# instead (see README, "URL parameters").

# Absolute origin of your Sub2API instance. Usually unnecessary: inside the
# iframe the origin is detected from document.referrer.
VITE_SUB2API_BASE_URL=https://api.example.com

# Fallback brand name, overridden by the instance's site_name setting.
# Also used for the very first paint before /api/v1/settings/public answers,
# so setting it avoids showing a generic name on a cold visit.
VITE_SITE_NAME=Sub2API

# External documentation URL. 0.2.17 has no /docs route, so leave this empty
# unless you host docs somewhere; it then falls back to the repository.
VITE_DOCS_URL=

VITE_REPO_URL=https://github.com/Wei-Shaw/sub2api
VITE_CONTACT_URL=

# The standalone price sheet ("价格" in the nav, "查看价格" in the hero).
# It is a separate deployment, not an instance route, so nothing on the
# instance can point at it — change it here (or with ?price= at runtime).
VITE_PRICING_URL=https://model.zhouwanx.top/

# "pricing" nav entry.
#   auto   (default) follow the instance's `payment_enabled` — the same single
#          opt-out switch 0.2.17 uses for the sidebar entry (featureFlag
#          flagPayment) and for the /purchase route guard (meta.requiresPayment).
#          Only an explicit false hides it; anything else keeps it visible.
#   always show it regardless and link to purchase_subscription_url or /purchase.
VITE_SHOW_PRICING=auto
